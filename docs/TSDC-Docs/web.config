<?xml version="1.0" encoding="utf-8"?>
<!--
  วางที่ C:\inetpub\wwwroot\TSDC-Docs บน 10.26.1.21 (คู่กับ updates.json)
  เว็บ TSDC อ่าน updates.json จากที่นี่เพื่อแสดงป้าย NEW / ปุ่ม "อัปเดต" ที่หัวเมนู
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- ถามก่อนใช้ทุกครั้ง แก้ updates.json แล้ว user เห็นทันทีหลัง F5 -->
      <clientCache cacheControlMode="DisableCache" />
      <!-- IIS รุ่นเก่าไม่รู้จัก .webp / .json จะตอบ 404 · remove ก่อนกันซ้ำกับของ server -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <!-- ให้ ng serve (localhost:4200) ตอนพัฒนาอ่าน updates.json ได้ เป็นเอกสารภายใน เปิดได้ -->
        <add name="Access-Control-Allow-Origin" value="*" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
