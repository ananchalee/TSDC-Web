<?xml version="1.0" encoding="utf-8"?>
<!--
  วางคู่กับ index.html ใน C:\inetpub\wwwroot\TSDC
  แก้ปัญหา "deploy แล้ว user ต้อง Ctrl+F5"

  ต้นเหตุ: IIS ไม่ส่ง Cache-Control มาเลย เบราว์เซอร์เลยเดาเองว่า index.html
  แคชได้ประมาณ 10% ของอายุไฟล์ (ไฟล์เก่า 1 วัน = แคชไว้ 2-3 ชม.) ระหว่างนั้น
  user จะยังโหลด main.<hash เก่า>.js อยู่ ทั้งที่วางไฟล์ใหม่ไปแล้ว

  ไฟล์ JS/CSS ที่ Angular build ออกมามี hash ในชื่ออยู่แล้ว (main.77783c53....js)
  build ใหม่ = ชื่อใหม่ = เบราว์เซอร์โหลดใหม่เอง ปัญหาจึงมีแค่ index.html ไฟล์เดียว
-->
<configuration>
  <system.webServer>
    <!-- DisableCache = ส่ง Cache-Control: no-cache
         แปลว่า "ถามก่อนใช้ทุกครั้ง" ไม่ใช่ "ห้ามแคช"
         ถ้าไฟล์ไม่เปลี่ยน IIS ตอบ 304 ตัวเปล่า ไม่ได้ส่งไฟล์ใหม่ (บน LAN ~10ms)

         ตั้งที่ระดับโฟลเดอร์ ไม่ใช่ <location path="index.html">
         เพราะ user เปิด http://10.26.1.21/TSDC/ ซึ่งไม่มีชื่อไฟล์ใน URL
         <location> จะจับไม่โดน default document -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>

  <!-- assets (AdminLTE, รูป, ฟอนต์) ไม่มี hash ในชื่อ แต่แทบไม่เคยเปลี่ยน
       ให้แคชยาว 7 วัน จะได้ไม่ต้องยิงถาม ~25 ไฟล์ทุกครั้งที่เปิดหน้า
       ** ถ้าวันไหนแก้ไฟล์ใน assets ต้องให้ user Ctrl+F5 รอบนั้นรอบเดียว ** -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
